# Copy to .env for local development:  cp .env.example .env
# Never commit .env — it is listed in .gitignore.
#
# Production (Railway, etc.): set these in the platform UI, not in a file.
# Variables already set in the environment are never overwritten by .env.

# --- Server ---
# ENV=development
# PORT=8080

# --- Plugin selection (stub | openai | deepgram | rime | silero) ---
# Used only when agent.NewConfig(agent.DefaultOptions()) is called without
# explicit provider names. Per-room agents should pass Options directly.
LLM_PROVIDER=openai
STT_PROVIDER=stub
TTS_PROVIDER=stub
VAD_PROVIDER=stub

# --- API keys (secrets — env is the right place for these) ---
OPENAI_API_KEY=

# --- Deepgram STT (when STT_PROVIDER=deepgram) ---
# DEEPGRAM_API_KEY=
# DEEPGRAM_MODEL=nova-2
# DEEPGRAM_LANGUAGE=en
# DEEPGRAM_WS_URL=wss://api.deepgram.com/v1/listen

# --- Rime TTS (when TTS_PROVIDER=rime) ---
# RIME_API_KEY=
# RIME_MODEL=mistv2          # coda | arcana | mistv1 | mistv2
# RIME_SPEAKER=cove          # must be a valid voice for the model
# RIME_SAMPLE_RATE=24000     # 8000|16000|22050|24000|44100|48000|96000
# RIME_WS_URL=wss://users-ws.rime.ai/ws3

# --- Agent behavior ---
# Configure via agent.Options / agent.Settings in code, not env.
# Example:
#   agent.NewConfig(agent.Options{
#       Settings: agent.Settings{
#           SystemPrompt: "You are a pizza bot.",
#           GreetingText: "Welcome to Joe's Pizza!",
#       },
#       LLMProvider: "openai",
#       LLM: llm.Options{
#           Model:       "gpt-4o-mini",
#           Temperature: ptr(0.7),
#           Extra: map[string]any{
#               "max_tokens": 500,
#               "top_p":      0.9,
#           },
#       },
#   })
