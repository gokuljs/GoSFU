# Copy to .env for local development:  cp .env.example .env
# Never commit .env — it is listed in .gitignore.
#
# Production (Railway, etc.): set these in the platform UI, not in a file.
# Variables already set in the environment are never overwritten by .env.

# --- Server ---
# ENV=development
# PORT=8080

# --- Plugin selection (stub | openai | deepgram | rime | silero) ---
LLM_PROVIDER=openai
STT_PROVIDER=stub
TTS_PROVIDER=stub
VAD_PROVIDER=stub

# --- OpenAI LLM (required when LLM_PROVIDER=openai) ---
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Deepgram STT (when STT_PROVIDER=deepgram) ---
# DEEPGRAM_API_KEY=
# DEEPGRAM_MODEL=nova-2

# --- TTS (when TTS_PROVIDER=rime or other) ---
# RIME_API_KEY=

# --- Agent behavior (optional; defaults in pkg/agent/config.go) ---
# AGENT_SYSTEM_PROMPT=You are a helpful, concise voice assistant.
# AGENT_GREETING=Hi, how can I help you today?
