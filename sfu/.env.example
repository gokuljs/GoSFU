# GoSFU — Backend Environment
# Copy to .env:  cp .env.example .env
# Never commit .env — it is listed in .gitignore.

# ──────────────────────────────────────────────
# Real provider credentials
# ──────────────────────────────────────────────

OPENAI_API_KEY=
DEEPGRAM_API_KEY=
RIME_API_KEY=
SILERO_MODEL_PATH=assets/models/silero_vad.onnx

# ──────────────────────────────────────────────
# Server
# ──────────────────────────────────────────────

# PORT=8080
# ENV=local
# NODE_ID=local
# SESSION_MAX_DURATION=30m
# Omit STUN_URLS to use the default Google/Cloudflare STUN list.
# Set STUN_URLS= (empty) to disable STUN entirely.
# STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302,stun:stun.cloudflare.com:3478
#
# Optional TURN server for production NAT traversal. Keep STUN enabled and add
# TURN as the fallback relay path for strict NATs and firewalls.
# The TURN username/password must match the coturn Docker --user value:
#   --user=gosfu:change-me
#
# Local coturn test:
# TURN_URLS=turn:localhost:3478?transport=udp,turn:localhost:3478?transport=tcp
#
# Production example:
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
# TURN_USERNAME=gosfu
# TURN_CREDENTIAL=change-me

# ──────────────────────────────────────────────
# Redis (optional — omit for in-memory fallback)
# ──────────────────────────────────────────────

# REDIS_URL=redis://localhost:6379

# ──────────────────────────────────────────────
# Provider selection
# ──────────────────────────────────────────────
# The room demo in pkg/room/room.go uses openai/deepgram/rime/silero.
# These env vars are for code paths that build agents with agent.DefaultOptions().

LLM_PROVIDER=openai
STT_PROVIDER=deepgram
TTS_PROVIDER=rime
VAD_PROVIDER=silero

# ──────────────────────────────────────────────
# Provider config (optional overrides)
# ──────────────────────────────────────────────

# OPENAI_MODEL=gpt-5.5

# DEEPGRAM_MODEL=nova-2
# DEEPGRAM_LANGUAGE=en
# DEEPGRAM_WS_URL=wss://api.deepgram.com/v1/listen

# RIME_MODEL=coda
# RIME_SPEAKER=lintel
# RIME_SAMPLE_RATE=24000
# RIME_WS_URL=wss://users-ws.rime.ai/ws3
